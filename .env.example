# Enterprise Knowledge Assistant - configuration template.
# Copy to .env and adjust. Every value here is a placeholder or a local-dev default;
# never commit real credentials. All settings are documented in backend/app/core/config.py.

# --- Application ---------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=console
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-64-char-random-hex-string-generated-locally-000000
PUBLIC_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY_HEADERS=false

# --- Host ports for docker compose (change if a port is already in use) -----------------
EKA_POSTGRES_PORT=5436
EKA_REDIS_PORT=6381
EKA_API_PORT=8081
EKA_FRONTEND_PORT=3000

# --- Local database roles (docker compose only; dev placeholders) ------------------------
POSTGRES_SUPERUSER_PASSWORD=postgres_dev_password
EKA_OWNER_PASSWORD=eka_owner_dev_password
EKA_APP_PASSWORD=eka_app_dev_password

# --- Database: runtime role (subject to RLS) and migration/owner role --------------------
DATABASE_URL=postgresql+psycopg://eka_app:eka_app_dev_password@localhost:5436/eka
MIGRATION_DATABASE_URL=postgresql+psycopg://eka_owner:eka_owner_dev_password@localhost:5436/eka
DB_APP_ROLE=eka_app
# Connection pool per process (the production connection budget is in docs/DEPLOYMENT_AWS.md).
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_STATEMENT_TIMEOUT_MS=30000

# --- Redis (rate limits, embedding cache, Celery broker) ---------------------------------
REDIS_URL=redis://localhost:6381/0
# CELERY_BROKER_URL=                 # unset: the broker is REDIS_URL
# Ingestion worker (docs/INGESTION.md). The lease is also the Celery time limit of one job.
# INGESTION_MAX_ATTEMPTS=3
# INGESTION_LEASE_SECONDS=900
# INGESTION_RETRY_BASE_SECONDS=30
# INGESTION_STALE_QUEUED_SECONDS=300
# WORKER_METRICS_PORT=9101

# --- Object storage -------------------------------------------------------------------
# local: files under LOCAL_STORAGE_PATH (no AWS needed). s3: AWS S3 or S3-compatible.
STORAGE_BACKEND=local
# LOCAL_STORAGE_PATH=/absolute/path/to/repo/backend/var/storage   # default; keep it absolute
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=            # only for S3-compatible services
# S3_PREFIX=
# S3_SSE=aws:kms              # AES256 | aws:kms | none
# S3_KMS_KEY_ID=
# S3_PRESIGN_TTL_SECONDS=300  # lifetime of download links

# --- Limits ---------------------------------------------------------------------------
MAX_UPLOAD_MB=50
MAX_REQUEST_BODY_KB=1024
# MAX_PDF_PAGES=2000
# MAX_DOCX_UNCOMPRESSED_MB=200
# MAX_PDF_UNCOMPRESSED_MB=200      # decoded PDF streams per document

# --- Sessions -------------------------------------------------------------------------
COOKIE_SECURE=false           # must be true in production (HTTPS)
SESSION_TTL_HOURS=12
SESSION_IDLE_TIMEOUT_MINUTES=120
ALLOW_PUBLIC_REGISTRATION=true
# COOKIE_DOMAIN=              # unset; only if the UI and the API are on different subdomains
# INVITATION_TTL_HOURS=168
# PASSWORD_MIN_LENGTH=12

# --- Rate limits (sign-in per client IP and account; chat, search, upload per user) ----
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN_PER_MINUTE=10
# RATE_LIMIT_REGISTER_PER_HOUR=20
# RATE_LIMIT_CHAT_PER_MINUTE=20
# RATE_LIMIT_SEARCH_PER_MINUTE=60
# RATE_LIMIT_UPLOAD_PER_MINUTE=20

# --- Embeddings -----------------------------------------------------------------------
# sentence_transformers (local, needs `uv sync --extra local-models`) | openai_compatible | hashing (tests only)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Must match the vector column created by the migrations (bge-small-en-v1.5 = 384).
EMBEDDING_DIMENSIONS=384
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
# EMBEDDING_API_BASE_URL=http://localhost:11434/v1
# EMBEDDING_API_KEY=
# EMBEDDING_DEVICE=auto               # auto | cpu | cuda | mps
# EMBEDDING_DOCUMENT_PREFIX=          # passage prefix; empty for BGE models
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_CACHE_TTL_SECONDS=604800  # 7 days; 0 disables the cache
# EMBEDDING_TIMEOUT_SECONDS=30        # openai_compatible only
# EMBEDDING_MAX_RETRIES=3             # openai_compatible only

# --- Reranker -------------------------------------------------------------------------
RERANKER_PROVIDER=cross_encoder   # cross_encoder | none
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANK_ENABLED=true
# RERANKER_DEVICE=auto              # auto | cpu | cuda | mps
# RERANKER_BATCH_SIZE=32
# RERANKER_MAX_LENGTH=512           # query + passage token limit

# --- LLM ------------------------------------------------------------------------------
# anthropic | openai_compatible (Ollama, vLLM, LM Studio, ...) | extractive (offline, no LLM)
LLM_PROVIDER=extractive
LLM_MODEL=claude-opus-5-5
# Optional cheaper model for follow-up question rewriting:
# LLM_QUERY_REWRITE_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=
ANTHROPIC_PLATFORM=anthropic      # anthropic | bedrock
ANTHROPIC_EFFORT=medium
ANTHROPIC_FALLBACKS=default       # server-side refusal fallbacks (Claude API only)
# ANTHROPIC_REWRITE_EFFORT=low
# AWS_REGION=us-east-1            # for ANTHROPIC_PLATFORM=bedrock
# Local LLM via Ollama's OpenAI-compatible API:
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b
# LLM_API_KEY=
# Ollama truncates prompts silently when they exceed its context window (often 4096
# tokens): start it with OLLAMA_CONTEXT_LENGTH=8192, or lower CONTEXT_MAX_TOKENS.
# Cost estimation (USD per million tokens) for the configured models:
LLM_INPUT_COST_PER_MTOK=0
LLM_OUTPUT_COST_PER_MTOK=0
# Unset by default: rewrites are priced with the answer model. Set LLM_REWRITE_INPUT_COST_PER_MTOK
# and LLM_REWRITE_OUTPUT_COST_PER_MTOK to price them separately.
# LLM_MAX_OUTPUT_TOKENS=16000
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_RETRIES=2
# LLM_TEMPERATURE=0.1                 # openai_compatible only (Claude models reject sampling parameters)

# --- Retrieval ------------------------------------------------------------------------
RETRIEVAL_MODE=hybrid             # vector | keyword | hybrid
RETRIEVAL_VECTOR_TOP_K=40
RETRIEVAL_KEYWORD_TOP_K=40
RETRIEVAL_RRF_K=60
RETRIEVAL_FUSED_TOP_K=30
RETRIEVAL_FINAL_TOP_K=8
CONTEXT_MAX_TOKENS=6000
FTS_CONFIG=english
# QUERY_REWRITE_ENABLED=true
# HNSW_EF_SEARCH=100
# MAX_QUERY_CHARS=2000
# CHAT_HISTORY_MESSAGES=6
# SEARCH_MAX_RESULTS=50
# Unset by default (no score cut). RETRIEVAL_MIN_RERANK_SCORE drops reranked candidates below
# a sigmoid score; see docs/RETRIEVAL.md before setting it.

# --- Chunking -------------------------------------------------------------------------
CHUNK_TARGET_TOKENS=350
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# --- Retention (days) -----------------------------------------------------------------
CONVERSATION_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=730
USAGE_RETENTION_DAYS=400

# --- Observability --------------------------------------------------------------------
# METRICS_ENABLED=true
# Bearer token for GET /metrics on the API. Empty or unset leaves /metrics open: set a long
# random value outside local development. The worker's metrics port (WORKER_METRICS_PORT)
# has no token, so keep it off public networks.
# METRICS_TOKEN=
