# Frontend configuration. Copy to .env.local for local development (never commit real values).

# Where the Next.js server proxies /api/* to (the FastAPI backend). Read when `next dev` / `next build`
# starts; the Docker image re-applies it at container start (see docker-entrypoint.mjs).
API_INTERNAL_URL=http://localhost:8081

# The port is not configured here: Next.js reads PORT from the process environment only,
# e.g. `PORT=3001 npm run dev`.
